# Copy to .env and fill in values appropriate to your environment.
# Docker Compose reads .env automatically.

# Backend CORS allow-list. Comma-separated full origins (scheme + host + port).
# Local dev default (if unset): http://localhost:5173
# Droplet example:
#   CORS_ORIGINS=http://203.0.113.10:5173
# Multiple origins:
#   CORS_ORIGINS=http://203.0.113.10:5173,https://invoices.example.com
CORS_ORIGINS=

# Vite dev-server allow-list. Hostnames only (no scheme, no port).
# Special value: * allows any host (convenient for demos, not recommended for production).
# Local dev default (if unset): localhost, 127.0.0.1
# Droplet example:
#   ALLOWED_HOSTS=203.0.113.10
# With a domain:
#   ALLOWED_HOSTS=invoices.example.com
ALLOWED_HOSTS=
